# ==============================================================================
# CrisisCore Backend — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and configure as needed.
# All values provide safe defaults for local development.

# --- Database & Storage ---
# Default: Async SQLite in local directory.
# PostgreSQL example: postgresql+asyncpg://crisiscore:crisiscore@localhost:5432/crisiscore
DATABASE_URL=sqlite+aiosqlite:///./crisiscore.db

# --- Redis Queue & PubSub ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication & JWT ---
# IMPORTANT: In production, generate a secure random secret (e.g. openssl rand -hex 32)
JWT_SECRET=crisiscore-dev-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- SLA & Auto-Reassignment ---
AUTO_REASSIGN_MINUTES=5
ASSIGNMENT_ACK_TIMEOUT_SECONDS=300

# --- Notifications ---
# Provider options: console, twilio, fcm
NOTIFICATION_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FCM_SERVER_KEY=

# --- ML & Risk Integration ---
RISK_API_URL=

# --- Data Freshness / TTL ---
# Maximum age (in minutes) before stored RiskZone models are marked stale
RISK_FRESHNESS_MINUTES=60

# --- Operational Priority Weights (Must sum to 1.0) ---
PRIORITY_W_RISK=0.35
PRIORITY_W_EXPOSURE=0.30
PRIORITY_W_VULNERABILITY=0.20
PRIORITY_W_RESPONSE_GAP=0.15
